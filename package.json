{
  "name": "waterturn",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "backend:setup": "node scripts/local-backend.mjs",
    "backend:dev": "tsx server/index.ts",
    "backend:user": "tsx scripts/create-user.ts",
    "backend:migrate": "tsx scripts/migrate.ts",
    "test:server": "vitest run --config server/vitest.config.ts",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "test:e2e:frontend": "playwright test workflow.spec.ts farmos.spec.ts operations.spec.ts",
    "test:e2e:full": "FARMOS_BACKEND_TESTS=1 playwright test"
  },
  "dependencies": {
    "decimal.js": "^10.6.0",
    "dexie": "^4.0.11",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "lucide-react": "^0.468.0",
    "papaparse": "^5.7.0",
    "pg": "^8.23.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^4.4.0",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^30.1.3",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~5.8.3",
    "vite": "^6.3.0",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^5.0.5"
  }
}
